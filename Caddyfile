# Automatic HTTPS for dotinschool-challenge. $DOMAIN comes from .env via compose.
# Caddy fetches + renews the Let's Encrypt certificate on its own.

{$DOMAIN} {
	encode zstd gzip
	# TLS policy (docs/security/TLS-POLICY.md): 1.2+ only; for 1.2, forward-
	# secret ECDHE with AEAD ciphers only (1.3 suites are all strong).
	tls {
		protocols tls1.2 tls1.3
		ciphers TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384 TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384 TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256 TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256 TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256 TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256
	}
	# CF-Connecting-IP is never a trusted source through this proxy; drop any
	# client-sent copy (Caddy sets X-Forwarded-For/-Proto itself).
	reverse_proxy app:8080 {
		header_up -CF-Connecting-IP
	}

	# HSTS — safe here because Caddy always terminates TLS for this site.
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
}
