# ────────────────────────────────────────────────────────────────────
#  dotinschool — configuration. Copy to .env and fill in:
#     cp .env.example .env
#  On Linux, scripts/install.sh generates /etc/dotinschool/dotinschool.env
#  for you with a random admin password and a secret admin path already set.
#  Anything already exported (systemd EnvironmentFile, Docker `environment:`)
#  overrides the value here.
# ────────────────────────────────────────────────────────────────────

# ── network ──
# Listen port. Behind a reverse proxy, front it and keep this internal.
PORT=8080
# Public domain — ONLY for the HTTPS setup (build/docker-compose.prod.yml).
# Leave empty for local / IP-only (plain HTTP, no certificate errors).
DOMAIN=

# Direct TLS without a proxy: point both at PEM files and the server serves
# HTTPS itself (scripts/install.sh sets these via `dotinschool cert`).
# SSL_CERT_PATH=/etc/dotinschool/ssl/example.com/fullchain.pem
# SSL_KEY_PATH=/etc/dotinschool/ssl/example.com/privkey.pem

# ── admin panel ──
ADMIN_USERNAME=administrator
# REQUIRED for a stable password. If empty, one is generated, printed to the
# log, and appended to this file so it stays put across restarts.
ADMIN_PASSWORD=
# Secret, hard-to-guess path for the admin panel (no leading slash).
# Empty = /admin. install.sh generates a random one like panel-9f3a7c1d.
ADMIN_PATH=
# Optional dedicated sub-domain for the admin panel (e.g. panel.example.com).
ADMIN_SUBDOMAIN=

# ── data ──
# Where arena.db + ai-config.json live. Default: <workdir>/data
# DATA_DIR=/opt/dotinschool/data

# ── SMS (ippanel) — registration / login OTP. Optional: without a key the OTP
#    endpoints return SMS_SEND_FAILED and nobody can register. ──
IPPANEL_API_KEY=
IPPANEL_SENDER=+98pro
IPPANEL_PATTERN_CODE=
IPPANEL_LOGIN_PATTERN_CODE=
IPPANEL_ADMIN_NOTIFY_PATTERN_CODE=
IPPANEL_ADMIN_PHONE=

# ── AI code-review assistant. Optional; also configurable from the panel,
#    which takes priority (panel DB → data/ai-config.json → these vars). Any
#    OpenAI-compatible Chat Completions service works. ──
AI_API_KEY=
# e.g. https://api.openai.com/v1 | https://api.gapgpt.app/v1 | https://api.groq.com/openai/v1
AI_BASE_URL=
# e.g. gpt-4o-mini | llama-3.3-70b-versatile
AI_MODEL=

# ── logging ──
# LOG_LEVEL=info   # trace|debug|info|warn|error
