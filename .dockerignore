# Keep the build context small and free of host-only / secret files.
#
# build/Dockerfile (the default, packaging image) only needs:
#   dist/dotinschool_linux_<arch>   (produced by scripts/docker-build.sh)
# build/Dockerfile.hermetic needs the full Go + web source tree.

.git
.gitattributes
.gitignore
.github
.claude
data
*.log
run.pid
.env
.env.*
!.env.example
web/node_modules
web/.vite
*.md
!README.md
scripts/install.sh
scripts/build.sh
scripts/docker-build.sh
build/docker-install.sh
dotinschool
dotinschool.exe

# dist/: keep only the linux binaries the packaging Dockerfile copies
dist/*
!dist/dotinschool_linux_amd64
!dist/dotinschool_linux_arm64
