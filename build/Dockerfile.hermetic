# dotinschool-challenge — FULLY HERMETIC multi-stage build (frontend + binary compiled
# inside the image). Ships only the binary + CA certs (pure-Go SQLite, CGO off).
#
# Prefer `make image` (build/Dockerfile) — it host-compiles the binary and the
# `docker build` becomes an unfailable 5-second copy. Use THIS file only for a
# no-toolchain CI box, and only with **~2 GB of free RAM for BuildKit**: the
# `go build` step is the memory hog and an under-provisioned Docker Desktop VM
# will drop the build with `rpc error: code = Unavailable ... EOF`. If that
# happens, raise Docker Desktop's memory (Settings → Resources) or just use
# `make image`.
#
#   docker build -f build/Dockerfile.hermetic -t dotinschool-challenge:local .

# ---- 1. build the Vue frontend ----
FROM node:22-alpine AS web
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY web/ ./
RUN npm run build:fast

# ---- 2. build the Go binary with the frontend embedded ----
FROM golang:1.27-alpine AS build
WORKDIR /src
# Module proxy + checksum DB. Defaults reach networks where proxy.golang.org /
# sum.golang.org are blocked; override with --build-arg for a normal network.
ARG GOPROXY=https://goproxy.cn,direct
ARG GOSUMDB=sum.golang.google.cn
ENV CGO_ENABLED=0 GOFLAGS=-trimpath GOPROXY=${GOPROXY} GOSUMDB=${GOSUMDB}
COPY go.mod go.sum ./
# goproxy.cn's own DNS lookup is occasionally flaky inside Docker Desktop's
# build network (intermittent "i/o timeout" from the internal resolver, not a
# block) — retry a few times instead of failing/appearing to hang on one bad
# lookup. Already-fetched modules are cached, so a retry only redoes the ones
# that failed.
RUN n=0; until [ $n -ge 5 ]; do \
      go mod download && break; \
      n=$((n + 1)); \
      echo "go mod download failed (attempt $n/5), retrying in 5s..." >&2; \
      sleep 5; \
    done; \
    if [ $n -ge 5 ]; then echo "go mod download failed after 5 attempts" >&2; exit 1; fi
COPY . .
# use the freshly built assets, not whatever was committed
RUN rm -rf web/assets
COPY --from=web /web/assets ./web/assets
# -p 1 keeps the compiler's peak memory down so a small Docker VM survives it.
RUN go build -p 1 -ldflags="-s -w" -o /out/dotinschool-challenge ./cmd/server

# ---- 3. minimal runtime ----
FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata wget && adduser -D -u 10001 app
WORKDIR /app
COPY --from=build /out/dotinschool-challenge /app/dotinschool-challenge

# Create the data dir with app ownership *before* declaring the VOLUME so a
# freshly-mounted named volume inherits it — otherwise the non-root user cannot
# open /app/data/arena.db (SQLITE_CANTOPEN).
RUN mkdir -p /app/data && chown -R app:app /app

ENV PORT=8080 \
    DATA_DIR=/app/data \
    DOTINSCHOOL_DOCKER=1 \
    TZ=Asia/Tehran

# arena.db + ai-config.json live here — mount a volume over it
VOLUME ["/app/data"]
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=4s --start-period=5s --retries=3 \
  CMD wget -qO- "http://127.0.0.1:${PORT}/api/config" >/dev/null 2>&1 || exit 1

USER app
ENTRYPOINT ["/app/dotinschool-challenge"]
