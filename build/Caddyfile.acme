# dotinschool — Caddy in front, serving a certificate that acme.sh already
# issued (Cloudflare-DNS or standalone-HTTP). Caddy does NOT run its own ACME
# here — it just terminates TLS with the files acme.sh dropped in /certs and
# reverse-proxies to the app. This is the path that works when the domain is
# proxied through Cloudflare (orange cloud), where Caddy's built-in HTTP/
# TLS-ALPN challenge can't reach the origin.
#
# $DOMAIN comes from .env via compose. /certs is ../certs/$DOMAIN on the host,
# refreshed by `dotinschool cert` and auto-renewed by acme.sh's cron.

{$DOMAIN} {
	encode zstd gzip
	tls /certs/fullchain.pem /certs/privkey.pem
	reverse_proxy app:8080
	header Strict-Transport-Security "max-age=15552000; includeSubDomains"
}
