# dotinschool-challenge — Caddy in front, serving a certificate that acme.sh already
# issued (Cloudflare-DNS or standalone-HTTP). Caddy does NOT run its own ACME
# here — it just terminates TLS with the files acme.sh dropped in /certs and
# reverse-proxies to the app. This is the path that works when the domain is
# proxied through Cloudflare (orange cloud), where Caddy's built-in HTTP/
# TLS-ALPN challenge can't reach the origin.
#
# $DOMAIN comes from .env via compose. /certs is ../certs/$DOMAIN on the host,
# refreshed by `dotinschool-challenge cert` and auto-renewed by acme.sh's cron.

{$DOMAIN} {
	encode zstd gzip
	# TLS policy (docs/security/TLS-POLICY.md): 1.2+ only; for 1.2, forward-
	# secret ECDHE with AEAD ciphers only (1.3 suites are all strong).
	tls /certs/fullchain.pem /certs/privkey.pem {
		protocols tls1.2 tls1.3
		ciphers TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384 TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384 TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256 TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256 TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256 TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256
	}
	# The app reads the visitor IP from X-Forwarded-For only (Caddy sets it,
	# and X-Forwarded-Proto, itself); drop a client-sent CF-Connecting-IP too.
	reverse_proxy app:8080 {
		header_up -CF-Connecting-IP
	}
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
}
