# Automatic HTTPS for dotinschool-challenge. $DOMAIN comes from .env via compose.
# Caddy fetches + renews the Let's Encrypt certificate on its own.

{$DOMAIN} {
	encode zstd gzip
	# CF-Connecting-IP is read first by the app; drop any client-sent copy so
	# it can't be used to fake a visitor IP (Caddy sets X-Forwarded-For itself).
	reverse_proxy app:8080 {
		header_up -CF-Connecting-IP
	}

	# HSTS — safe here because Caddy always terminates TLS for this site.
	header Strict-Transport-Security "max-age=15552000; includeSubDomains"
}
